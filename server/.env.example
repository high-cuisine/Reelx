# === PostgreSQL (docker-compose) ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gifts
POSTGRES_PORT=5432

# === Database ===
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/gifts?schema=public

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# === Main server ===
PORT=3333
ADMIN_PORT=3002
TELEGRAM_BOT_TOKEN=
# HTTPS-URL мини-приложения (не ссылка на бота t.me/YourBot)
APP_LINK=https://reelx.online
MARKETAPP_API_TOKEN=
MARKETAPP_API_URL=https://api.marketapp.ws
# Локально (без Docker): http://localhost:3334
# В Docker (docker-compose): не задавать — compose сам подставит http://nftbuyber:3001
NFT_BUYER_URL=http://localhost:3334
# От какой ставки (TON) включать микс валюты с игрушками в колесе (по умолчанию 20)
GIFTS_MONEY_MIX_MIN_TON=20
TON_PRICE_URL=https://tonapi.io/v2/rates?tokens=ton&currencies=usd
JWT_SECRET=
# bcrypt: для Docker в .env каждый $ удваивать ($$). Локально без Docker — один $.
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=

# === NFT Buyer ===
NFTBUYBER_PORT=3334
MARKETPLACE_API_KEY=
TON_API_KEY=
TON_API_URL=https://toncenter.com/api/v3
WALLET_MNEMONIC=
GETGEMS_API_KEY=
# tonapi.io key (https://tonconsole.com) — снимает rate limit на TonAPI
TONAPI_IO_KEY=

# === Admin client (Vite) ===
VITE_API_BASE=http://localhost:3002/api/admin-c7ad44cbad762a5da0a4/admin
